<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcomeMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp"
    tools:context=".WelcomeActivity">

    <!-- Espacio Superior Flex -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Tarjeta Central de Pokebola Protagonista -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="36dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:contentDescription="Icono Pokéball"
            android:src="@drawable/ic_pokeball" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Título de la App: PokéDex Explorer. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PokéDex"
            android:textColor="#0F172A"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explorer."
            android:textColor="#DC2626"
            android:textSize="32sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Subtítulo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxWidth="280dp"
        android:text="Descubre el mundo Pokémon con datos oficiales de PokéAPI"
        android:textColor="#64748B"
        android:textSize="14sp" />

    <!-- Insignia "SISTEMA LISTO" -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_status_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="Status Dot"
            android:src="@drawable/ic_status_dot" />

        <TextView
            android:id="@+id/tvWelcomeSyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.08"
            android:text="SISTEMA LISTO"
            android:textColor="#15803D"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Espacio Flex Medio -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2" />

    <!-- Tres Puntos Rojos de Carga -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/ic_status_dot"
            android:backgroundTint="#DC2626" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/ic_status_dot"
            android:backgroundTint="#DC2626" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/ic_status_dot"
            android:backgroundTint="#DC2626" />

    </LinearLayout>

    <!-- Footer Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Versión 1.0.0 • Powered by PokéAPI"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:letterSpacing="0.06"
        android:text="ÍNDICE NACIONAL KANTO – PALDEA"
        android:textColor="#CBD5E1"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
