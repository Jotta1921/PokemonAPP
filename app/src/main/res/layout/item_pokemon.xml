<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Contenedor cuadrado con fondo gris suave para el Sprite -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardBackgroundColor="#F1F5F9"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivPokemon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="Pokemon Sprite"
                android:scaleType="fitCenter"
                tools:src="@tools:sample/avatars" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Información central -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPokemonId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="#001" />

            <TextView
                android:id="@+id/tvPokemonName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Bulbasaur" />

            <!-- Contenedor Horizontal para Tipos -->
            <LinearLayout
                android:id="@+id/layoutTypesContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPokemonType1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#475569"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="PLANTA" />

                <TextView
                    android:id="@+id/tvPokemonType2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip"
                    android:backgroundTint="#E2E8F0"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="#475569"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="VENENO" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botón de Favorito -->
        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorito"
            android:padding="10dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="#64748B" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
